PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173
DATABASE_URL=

# Firebase Admin SDK (Server-Side Only)
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# Cloudinary (Server-Side Only - Optional)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Optional AI narration + free-text parsing layer (Google Gemini, free tier)
# AI NARRATES AND PARSES ONLY. It never computes a match score or makes a
# nutrition recommendation — that stays with the deterministic matching engine
# and the static reference dataset.
# AI_ENABLED unset => enabled in development/test, DISABLED in production.
# When disabled (or when the key is missing in development) /api/v1/ai/explain
# falls back to a deterministic template and /api/v1/ai/parse-donation returns [].
# In production the key is only required when AI_ENABLED=true.
AI_ENABLED=
GEMINI_API_KEY=
# Production model: gemini-3.5-flash-lite, selected for reliability rather than
# maximum model capability.
# gemini-2.5-flash is retired (404 for new users). Use gemini-flash-latest to
# auto-track the newest Flash model instead.
# NOTE: the fallback default also lives in src/services/geminiClient.js (DEFAULT_MODEL).
# Keep the two in sync, or set this var explicitly on every host.
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_TIMEOUT_MS=15000

# Business Settings
REQUIREMENT_EXPIRY_DAYS=30
